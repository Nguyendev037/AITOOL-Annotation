# =============================================================================
# CVAT Smart Model Service — environment template (non-secret)
#
# Copy to `.env` and adjust. Docker Compose reads these automatically.
# Values shown are the production defaults.
# =============================================================================

# ---- Object detection (YOLO26) ----
YOLO26_MODEL=yolo26m.pt
YOLO26_CONF=0.25
YOLO26_IOU=0.45

# ---- Semantic segmentation ----
# Backend: eomt | mask2former | segformer
SEMANTIC_BACKEND=eomt
SEMANTIC_MODEL_ID=tue-mps/eomt-dinov3-coco-panoptic-large-640
# SAM2 boundary refinement (objects only)
SEMANTIC_REFINE=true
SEMANTIC_SPLIT_INSTANCES=true
SEMANTIC_MIN_COMPONENT_AREA=100

# ---- SAM2 ----
SAM2_DEVICE=cuda
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_l.yaml
SAM2_CHECKPOINT=/models/sam2.1_hiera_large.pt

# ---- Image enhancement (preprocessing) ----
ENHANCE_ENABLED=true
ENHANCE_DARK_REGIONS=true
ENHANCE_MOTION_BLUR=false

# ---- CVAT localhost (tools/cvat_labels.py) ----
# Used to compare task labels against taxonomy.yaml before auto-annotation.
# Mint a token with:
#   docker exec cvat_server python manage.py drf_create_token <username>
# Alternatively set CVAT_LOCAL_USERNAME / CVAT_LOCAL_PASSWORD instead of a token.
CVAT_LOCAL_URL=http://localhost:8080
CVAT_LOCAL_TOKEN=

# ---- Guideline sync (tools/sync_guidelines.py, optional) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
